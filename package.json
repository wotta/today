{
  "name": "today-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@today/extension' dev",
    "build": "bun run --filter '@today/extension' build",
    "compile": "bun run --filter '@today/extension' compile",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '@today/extension' test:e2e"
  }
}
